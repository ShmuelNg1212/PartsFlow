# Copy to .env.local and fill in. Git ignores .env.local.

# Browser-safe values (Vite exposes only VITE_ variables to the frontend).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Never prefix a secret with VITE_ (R-DATA-6).
SUPABASE_PROJECT_REF=<project-ref>
# Postgres connection string, for running the database suite against real Supabase.
SUPABASE_DB_URL=

# Local database tests (test:db). Defaults to the local PostgreSQL server.
TEST_PG_URL=postgres://localhost:5432/postgres

# Seed scripts write these on first run (generated passwords). Do not commit .env.local.
# node scripts/seed-dev-users.mjs → E2E_OWNER_EMAIL, E2E_OWNER_PASSWORD, E2E_STAFF_EMAIL, E2E_STAFF_PASSWORD
# node scripts/seed-demo.mjs      → DEMO_OWNER_EMAIL, DEMO_OWNER_PASSWORD, DEMO_STAFF_EMAIL, DEMO_STAFF_PASSWORD
# node scripts/seed-live-shop.mjs → LIVE_OWNER_PASSWORD
